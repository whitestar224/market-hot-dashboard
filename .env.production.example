# Copy this file to .env.production before deployment.
# Never commit .env.production.

XINGYUN_ENV=production
XINGYUN_HOST=0.0.0.0
PORT=8765
XINGYUN_PUBLIC_BASE_URL=https://your-domain.com
XINGYUN_COOKIE_SECURE=1
XINGYUN_LOAD_ENV_EXAMPLE=0
# Required for production data-at-rest encryption.
# Generate once and keep it in your server secret manager, never in Git:
# python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
XINGYUN_FIELD_ENCRYPTION_KEY=

# Docker base image. Public ECR is often easier to pull than Docker Hub on CN networks.
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim

# Optional host proxy for local Docker. Example:
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
NO_PROXY=127.0.0.1,localhost,host.docker.internal

# Production safety switches.
XINGYUN_EXPOSE_DEV_EMAIL_CODE=0
XINGYUN_EXPOSE_DEV_PHONE_CODE=0
XINGYUN_DISABLE_DESKTOP_ALERT=1
XINGYUN_DESKTOP_ALERT_BRIDGE_URL=
XINGYUN_DISABLE_SITE_ALERT_MONITOR=0
XINGYUN_DISABLE_WECHAT_AUTH_MONITOR=0

# Strategy execution. Keep live trading disabled until exchange permissions and
# the live-order adapter have been reviewed. Per-user credentials are encrypted
# in the database; these values are optional server-wide fallbacks.
STRATEGY_LIVE_TRADING_ENABLED=0
STRATEGY_MAX_ORDER_NOTIONAL_USDT=25000
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional OKX OnchainOS Market API credentials for contract-first DEX candles.
OKX_DEX_API_KEY=
OKX_DEX_SECRET_KEY=
OKX_DEX_PASSPHRASE=
BITGET_API_KEY=
BITGET_API_SECRET=

# Optional AI analysis.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CACHE_TTL_SECONDS=21600

# Optional X KOL tracking. X API v2 is usage-billed. A bearer token alone does not
# enable paid reads; explicitly opt in only after reviewing X usage pricing.
X_BEARER_TOKEN=
# With a bearer token, keep the paid live stream on for priority handles only.
X_KOL_OFFICIAL_API_ENABLED=1
# Keep at 0 to receive only posts created after the Filtered Stream connects.
X_KOL_OFFICIAL_REST_POLL_ENABLED=0
# Perform one recent-history read after each service start to recover missed owner mentions.
X_KOL_STARTUP_HISTORY_RECOVERY_ENABLED=1
# RSS remains enabled in parallel; this stream receives only newly published posts.
X_KOL_FILTERED_STREAM_ENABLED=1
X_KOL_STREAM_ALL_TRACKED_ACCOUNTS=0
X_KOL_ALLOW_SHARED_STREAM_RULES=0
X_KOL_REALTIME_RSS_INTERVAL_SECONDS=3
X_KOL_REALTIME_API_INTERVAL_SECONDS=15
X_KOL_RSS_TIMEOUT_SECONDS=4
X_KOL_RSS_MIRROR_WORKERS=4
X_KOL_RSS_SOURCE_WORKERS=4
X_KOL_RSS_MIRROR_ATTEMPTS=2
X_KOL_RSS_CIRCUIT_BASE_SECONDS=15
X_KOL_RSS_CIRCUIT_MAX_SECONDS=300
X_KOL_PRIORITY_HANDLES=whitestar224
# Repair monitor entries from owner posts published while the service was offline.
PERSONAL_X_MONITOR_BACKFILL_DAYS=3
X_KOL_PRIORITY_RSS_INTERVAL_SECONDS=1
X_KOL_PRIORITY_API_INTERVAL_SECONDS=15
X_KOL_PRIORITY_RSS_TIMEOUT_SECONDS=6
X_KOL_PRIORITY_RSS_MIRRORS=3
X_RSS_BASES=https://rsshub.app/twitter/user/{handle},https://xcancel.com/{handle}/rss,https://lightbrd.com/{handle}/rss,https://nitter.space/{handle}/rss,https://nitter.poast.org/{handle}/rss

# Free self-hosted translation used by X tracking and desktop alerts.
LIBRETRANSLATE_ENABLED=1
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT=45
LIBRETRANSLATE_AUTOSTART=0
LIBRETRANSLATE_EXECUTABLE=
TRANSLATION_LLM_FALLBACK=0

# Optional automation brief fallback.
# Daily automation can run:
# python tools/publish_automation_briefs.py --push
AUTOMATION_BRIEFS_REMOTE_URL=https://raw.githubusercontent.com/whitestar224/market-hot-dashboard/main/docs/automation-briefs.json
AUTOMATION_BRIEFS_REMOTE_TTL_SECONDS=120

# Email verification. Use one SMTP provider for production delivery.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_TLS=1
EMAIL_WEBHOOK_URL=

# Prefer the existing Discord bot application. Use the Bot page token, not the OAuth client secret.
PRICE_WATCH_DISCORD_BOT_TOKEN=
PRICE_WATCH_DISCORD_CHANNEL_ID=
# Optional fallback when the bot is not configured.
PRICE_WATCH_DISCORD_WEBHOOK_URL=

# Public-chain ecosystem monitor. First successful scan establishes a baseline
# and does not replay old desktop alerts.
CHAIN_ECOSYSTEM_REFRESH_SECONDS=300
XINGYUN_DISABLE_CHAIN_ECOSYSTEM_MONITOR=0
GITHUB_TOKEN=

# Independent DingTalk price-watch delivery worker.
DINGTALK_PRICE_WATCH_WEBHOOK_URL=

# Local-only QQ background bridge (NapCat / OneBot 11).
QQ_ONEBOT_ENABLED=0
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:3000
QQ_ONEBOT_WS_URL=ws://127.0.0.1:3001
QQ_ONEBOT_TOKEN=
QQ_ONEBOT_ACCOUNT=
QQ_CLIENT_PATH=
QQ_NAPCAT_RUNTIME_DIR=
QQ_ONEBOT_RECOVERY_ENABLED=0
QQ_UI_FALLBACK_ENABLED=0
DINGTALK_PRICE_WATCH_SECRET=
DINGTALK_PRICE_WATCH_API_URL=http://127.0.0.1:8765/api/price-watch
DINGTALK_PRICE_WATCH_DASHBOARD_URL=http://127.0.0.1:8765/price-watch.html
DINGTALK_PRICE_WATCH_POLL_SECONDS=60
DINGTALK_PRICE_WATCH_TIMEOUT_SECONDS=10
DINGTALK_PRICE_WATCH_STATE_PATH=.runtime-cache/dingtalk-price-watch-state.json
DINGTALK_PRICE_WATCH_SEND_EXISTING_ON_FIRST_RUN=0

# Google OAuth. Redirect URI:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional market data overrides.
OKX_WEB_USER_AGENT=
OKX_WEB_COOKIE=
OKX_WEB_TOKEN=
OKX_WEB_TOKEN_HEADER=Authorization
OKX_EXTRA_HEADERS=
BITGET_WEB_USER_AGENT=
BITGET_WEB_COOKIE=
BITGET_EXTRA_HEADERS=

# Optional local desktop reverse-proxy endpoints.
# Keep empty on a normal cloud deployment.
OKX_DESKTOP_PROXY_CONNECT_HOST=host.docker.internal
OKX_DESKTOP_PROXY_PORTS=
AICOIN_CDP_HOST=host.docker.internal
AICOIN_CDP_PORT=
AICOIN_USER_DATA_DIR=/host-aicoin

# News Trade dual-score thresholds and transition-alert controls.
NEWS_TRADE_CULTURE_STATIC_MIN=42
NEWS_TRADE_EVENT_OBSERVATION_MIN=45
NEWS_TRADE_EVENT_TRADE_MIN=62
NEWS_TRADE_ONCHAIN_TRADE_MIN=62
NEWS_TRADE_HIGH_VELOCITY_MIN=68
NEWS_TRADE_HIGH_RANK_MIN=68
NEWS_TRADE_MIN_LIQUIDITY_USD=100000
NEWS_TRADE_ALERT_COOLDOWN_SECONDS=1800
NEWS_TRADE_ALERT_STATE_RETENTION_SECONDS=1209600
NEWS_TRADE_DISCOVERY_CACHE_SECONDS=300
NEWS_TRADE_TRENDING_NETWORKS=bsc,solana,base,eth
