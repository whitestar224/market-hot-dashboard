# Optional: keep AICoin OpenAPI credentials for future signed endpoints.
# The current dashboard does not use hotTabCoins as a fallback because it does not match
# the desktop "热门榜单 / 总览 / 热门" card shown in the AIcoin app.
AICOIN_ACCESS_KEY_ID=
AICOIN_ACCESS_SECRET=
AICOIN_TOKEN=
AICOIN_AUTH_TOKEN=
AICOIN_WEB_TOKEN=
AICOIN_CURRENCY=usd
AICOIN_CDP_HOST=127.0.0.1
AICOIN_CDP_PORT=9222
AICOIN_CDP_TARGET_HINT=#/main/exchange
AICOIN_AXIOS_MODULE_ID=0x25c5
AICOIN_HOT_SIZE=20
AICOIN_PAYLOAD_TOKEN=
AICOIN_TOKEN_TRY_LIMIT=8
AICOIN_EXE_PATH=D:/AICOIN/AiCoin.exe
AICOIN_AUTO_RELAUNCH_CDP=0

# Optional: local data security.
# Generate a stable 32-byte key before deployment:
# python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this key outside Git and back it up. If it is lost, encrypted profile/model keys cannot be recovered.
XINGYUN_ENV=development
XINGYUN_FIELD_ENCRYPTION_KEY=
XINGYUN_COOKIE_SECURE=0

# Optional: DeepSeek model analysis for ranking row narratives.
# The API key is only used by the local Python server and will not be exposed to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=24
DEEPSEEK_MAX_ROWS=36
DEEPSEEK_BATCH_ROWS=10
DEEPSEEK_MAX_TOTAL_ROWS=300
DEEPSEEK_MAX_TOKENS=1800
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_INSIGHT_CACHE_TTL=86400

# Free local X/Twitter translation. Start LibreTranslate with Docker Compose.
# A local Python server uses 127.0.0.1; the app container overrides this with the service name.
LIBRETRANSLATE_ENABLED=1
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT=45
# When the local Python environment exists, server.py starts it automatically.
LIBRETRANSLATE_AUTOSTART=1
LIBRETRANSLATE_EXECUTABLE=
# Keep disabled to guarantee translation never consumes a paid model API.
TRANSLATION_LLM_FALLBACK=0
# Recent local news/X/brief context used by DeepSeek row analysis.
MARKET_NARRATIVE_LOOKBACK_DAYS=7
MARKET_NARRATIVE_CONTEXT_LIMIT=180
# Optional JSON override, for example:
# MARKET_NARRATIVE_OVERRIDES={"HYPE":["价格新高 + ETF叙事 + Hyperliquid链上交易所重估"]}
MARKET_NARRATIVE_OVERRIDES=

# Optional: OKX web session headers for the official futures ranking endpoint.
# Open https://www.okx.com/zh-hans/markets/rankings/futures in a normal browser,
# copy the request cookie/header from DevTools if the unauthenticated endpoint returns empty.
OKX_WEB_COOKIE=
OKX_WEB_TOKEN=
OKX_WEB_TOKEN_HEADER=Authorization
OKX_WEB_USER_AGENT=
# Semicolon separated, for example: devid=xxx;x-cdn-token=yyy
OKX_EXTRA_HEADERS=
OKX_PRODUCT_TYPE=futures
OKX_FUTURES_TYPE=USDT
OKX_COUNTRY_FILTER=1
OKX_RANK_ZONE=utc24
OKX_DESKTOP_PROXY_ENABLED=auto
OKX_DESKTOP_PROXY_CONNECT_HOST=127.0.0.1
OKX_DESKTOP_PROXY_PORTS=17000,17001,17002,17003,17004,17005
OKX_DESKTOP_PROXY_HOST=www.okx.com
OKX_DESKTOP_USER_AGENT=OKX/2.6.1
OKX_DESKTOP_PROXY_TIMEOUT=2
OKX_ENABLE_WS=0
OKX_ALLOW_ESTIMATED_HOT_FALLBACK=0
# Spot mode is now only used when OKX_PRODUCT_TYPE=spot; futures mode will not fall back to spot data.
OKX_SPOT_TYPE=USDT
OKX_SPOT_PAGE_SIZE=10

# Optional: Bitget official hot ranking endpoint.
# index=8 matches https://www.bitget.com/v1/mix/market/indexLeaderboard-get?index=8
BITGET_HOT_INDEX=8
BITGET_WEB_COOKIE=
BITGET_WEB_USER_AGENT=
# Semicolon separated, for example: terminalCode=WEB;languageType=1
BITGET_EXTRA_HEADERS=

# Optional: Ave.ai Markets hot search ranking.
# Ave.ai web requests require the anti-abuse token generated by ave.ai/vemachine.js.
# Open https://ave.ai/ in DevTools, copy X-Auth and optional ave-udid from a
# /v1api/v4/tokens/treasure/list request.
AVE_API_BASE=https://h5.phaetd4l.com
AVE_X_AUTH=
AVE_UDID=
AVE_WEB_USER_AGENT=
AVE_READ_BROWSER_STORAGE=1
AVE_AUTO_GENERATE_TOKEN=1
# Optional comma separated Chrome/Edge profile paths. Empty = auto scan default profiles.
AVE_BROWSER_PROFILE_DIRS=
# Semicolon separated, for example: X-Auth=xxx;ave-udid=yyy
AVE_EXTRA_HEADERS=

# Optional: WeWe RSS compatible WeChat public account platform.
# When configured, RSS page can resolve mp.weixin.qq.com article links to account IDs
# and fetch latest articles through the same platform flow used by WeWe RSS.
# The app can also create a WeRead QR login from the RSS page and save the token locally
# under .runtime-cache/wechat_accounts.json, so .env credentials are no longer mandatory.
WECHAT_PLATFORM_URL=https://weread.111965.xyz
WECHAT_ACCOUNT_ID=
WECHAT_ACCOUNT_TOKEN=
WECHAT_ACCOUNT_NAME=

# Optional: X / Twitter KOL tracking.
# X API v2 is usage-billed. When a bearer token is configured, the live Filtered Stream
# is enabled by default for X_KOL_PRIORITY_HANDLES only. RSS remains enabled in parallel.
X_BEARER_TOKEN=
X_KOL_OFFICIAL_API_ENABLED=1
# Keep this at 0 for stream-only listening. Enabling it performs paid recent/history reads.
X_KOL_OFFICIAL_REST_POLL_ENABLED=0
# One paid recent-history read on startup repairs owner mentions published while
# the service was offline; continuous paid REST polling remains disabled above.
X_KOL_STARTUP_HISTORY_RECOVERY_ENABLED=1
# Number of latest activities to keep per KOL. Official API can paginate; RSS fallback
# depends on the upstream RSS service and may still be incomplete.
X_KOL_FETCH_LIMIT=80
X_KOL_PAGE_LIMIT=3
# On every startup/poll, replay recent owner posts into both monitor pools so
# mentions made while the service was offline are not missed (clamped to 1-7 days).
PERSONAL_X_MONITOR_BACKFILL_DAYS=3
X_KOL_INCLUDE_REPLIES=1
X_KOL_INCLUDE_RETWEETS=1
# 0 = keywords are only used for tagging/highlighting; 1 = keywords filter out posts.
X_KOL_STRICT_KEYWORDS=0
X_KOL_REALTIME_RSS_INTERVAL_SECONDS=3
X_KOL_REALTIME_API_INTERVAL_SECONDS=15
X_KOL_RSS_TIMEOUT_SECONDS=4
X_KOL_RSS_MIRROR_WORKERS=4
X_KOL_RSS_SOURCE_WORKERS=4
X_KOL_RSS_MIRROR_ATTEMPTS=2
X_KOL_RSS_CIRCUIT_BASE_SECONDS=15
X_KOL_RSS_CIRCUIT_MAX_SECONDS=300
# Dedicated low-latency lane for the owner's account. The live stream receives only new
# posts after connection; RSS keeps the feed/history. REST history reads stay disabled.
X_KOL_PRIORITY_HANDLES=whitestar224
X_KOL_PRIORITY_RSS_INTERVAL_SECONDS=1
X_KOL_PRIORITY_API_INTERVAL_SECONDS=15
X_KOL_PRIORITY_RSS_TIMEOUT_SECONDS=6
X_KOL_PRIORITY_RSS_MIRRORS=3
# Paid persistent Filtered Stream for priority handles.
X_KOL_FILTERED_STREAM_ENABLED=1
# Keep the paid stream scoped to priority handles by default. Setting this to 1 can
# create rules for every user's tracked account and increase billable reads sharply.
X_KOL_STREAM_ALL_TRACKED_ACCOUNTS=0
# Refuse to manage an X App that already has unrelated stream rules by default.
X_KOL_ALLOW_SHARED_STREAM_RULES=0
# Comma separated templates. Use {handle} as the username placeholder.
X_RSS_BASES=https://rsshub.app/twitter/user/{handle},https://xcancel.com/{handle}/rss,https://lightbrd.com/{handle}/rss,https://nitter.space/{handle}/rss,https://nitter.poast.org/{handle}/rss

# Optional: Login providers.
# Email login works locally without SMTP/webhook and returns a dev verification code.
# Set XINGYUN_EXPOSE_DEV_EMAIL_CODE=1 only for local debugging without email delivery.
EMAIL_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_FROM_NAME=星云社
EMAIL_SMTP_TLS=1
EMAIL_SMTP_SSL=0
# Optional fallback mailboxes. If configured, the server tries them in order.
# EMAIL_SMTP_1_HOST=smtp.qq.com
# EMAIL_SMTP_1_PORT=465
# EMAIL_SMTP_1_USERNAME=
# EMAIL_SMTP_1_PASSWORD=
# EMAIL_SMTP_1_FROM=
# EMAIL_SMTP_1_SSL=1
# EMAIL_SMTP_1_TLS=0
# EMAIL_SMTP_2_HOST=smtp.gmail.com
# EMAIL_SMTP_2_PORT=587
# EMAIL_SMTP_2_USERNAME=
# EMAIL_SMTP_2_PASSWORD=
# EMAIL_SMTP_2_FROM=
# EMAIL_SMTP_2_SSL=0
# EMAIL_SMTP_2_TLS=1
XINGYUN_EXPOSE_DEV_EMAIL_CODE=0

# Legacy phone login hooks are kept for backward compatibility only.
SMS_WEBHOOK_URL=

# Prefer the existing Discord bot application. Use the Bot page token, not the OAuth client secret.
PRICE_WATCH_DISCORD_BOT_TOKEN=
PRICE_WATCH_DISCORD_CHANNEL_ID=
# Optional fallback when the bot is not configured.
PRICE_WATCH_DISCORD_WEBHOOK_URL=

# News Trade dual-score thresholds and transition-alert controls.
NEWS_TRADE_CULTURE_STATIC_MIN=42
NEWS_TRADE_EVENT_OBSERVATION_MIN=45
NEWS_TRADE_EVENT_TRADE_MIN=62
NEWS_TRADE_ONCHAIN_TRADE_MIN=62
NEWS_TRADE_HIGH_VELOCITY_MIN=68
NEWS_TRADE_HIGH_RANK_MIN=68
NEWS_TRADE_MIN_LIQUIDITY_USD=100000
NEWS_TRADE_ALERT_COOLDOWN_SECONDS=1800
NEWS_TRADE_ALERT_STATE_RETENTION_SECONDS=1209600
NEWS_TRADE_DISCOVERY_CACHE_SECONDS=300
NEWS_TRADE_TRENDING_NETWORKS=bsc,solana,base,eth

# Public-chain ecosystem monitor. Uses public GeckoTerminal, DEX Screener,
# DefiLlama, Blockscout and GitHub endpoints; no paid key is required.
CHAIN_ECOSYSTEM_REFRESH_SECONDS=300
XINGYUN_DISABLE_CHAIN_ECOSYSTEM_MONITOR=0
# Optional: raises GitHub API rate limits for manually added project repositories.
GITHUB_TOKEN=

# Independent DingTalk price-watch delivery worker.
# Create a custom group robot, enable signature security, then copy its values here.
DINGTALK_PRICE_WATCH_WEBHOOK_URL=

# QQ background group monitoring through a local NapCat / OneBot 11 bridge.
# Keep both endpoints on loopback and use the same non-empty token in NapCat.
QQ_ONEBOT_ENABLED=0
QQ_ONEBOT_HTTP_URL=http://127.0.0.1:3000
QQ_ONEBOT_WS_URL=ws://127.0.0.1:3001
QQ_ONEBOT_TOKEN=
QQ_ONEBOT_ACCOUNT=
QQ_CLIENT_PATH=
QQ_NAPCAT_RUNTIME_DIR=
# Disabled by default: recovery may launch a managed QQ session. Enable only on a dedicated account.
QQ_ONEBOT_RECOVERY_ENABLED=0
# Emergency-only legacy window/OCR fallback. Disable after OneBot is connected.
QQ_UI_FALLBACK_ENABLED=0
DINGTALK_PRICE_WATCH_SECRET=
DINGTALK_PRICE_WATCH_API_URL=http://127.0.0.1:8765/api/price-watch
DINGTALK_PRICE_WATCH_DASHBOARD_URL=http://127.0.0.1:8765/price-watch.html
DINGTALK_PRICE_WATCH_POLL_SECONDS=60
DINGTALK_PRICE_WATCH_TIMEOUT_SECONDS=10
DINGTALK_PRICE_WATCH_STATE_PATH=.runtime-cache/dingtalk-price-watch-state.json
# Default 0 baselines old episodes on first startup. Set 1 to send current near-high signals.
DINGTALK_PRICE_WATCH_SEND_EXISTING_ON_FIRST_RUN=0
XINGYUN_EXPOSE_DEV_PHONE_CODE=0

# Google OAuth login. Add this redirect URI in Google Cloud:
# http://127.0.0.1:8765/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
XINGYUN_PUBLIC_BASE_URL=http://127.0.0.1:8765

# Strategy execution safety. Users can configure encrypted per-account exchange
# credentials from strategy.html; these values are optional server-wide fallbacks.
STRATEGY_LIVE_TRADING_ENABLED=0
STRATEGY_MAX_ORDER_NOTIONAL_USDT=25000
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional OKX OnchainOS Market API credentials for contract-first DEX candles.
OKX_DEX_API_KEY=
OKX_DEX_SECRET_KEY=
OKX_DEX_PASSPHRASE=
BITGET_API_KEY=
BITGET_API_SECRET=

# Optional: start the Discord BlockBeats newsflash bridge together with server.py.
# The bridge project defaults to ../discord-alpha-observer and must have NEWSFLASH_WEBHOOK_URL in its .env.
XINGYUN_DISCORD_NEWSFLASH_ENABLED=1
XINGYUN_DISCORD_NEWSFLASH_ROOT=

# Optional automation brief fallback for Docker/online deployment.
# After daily automations finish, publish the latest JSON with:
# python tools/publish_automation_briefs.py --push
AUTOMATION_BRIEFS_REMOTE_URL=https://raw.githubusercontent.com/whitestar224/market-hot-dashboard/main/docs/automation-briefs.json
AUTOMATION_BRIEFS_REMOTE_TTL_SECONDS=120
