{
  "name": "xingyunshe-market-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "星云社跨市场热门榜雷达桌面端",
  "main": "electron/main.js",
  "author": "Xingyun Society",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "python tools/run_tests.py",
    "test:py": "python tools/run_tests.py --exclude \"test_ten_critical_signals,contract_identity,test_acceleration,test_port_binding,test_worker_discards_queued_ths\" --watchdog 600",
    "monitor:build-buy": "esbuild tools/monitor-buy-executor-entry.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=web/assets/monitor-buy-executor.js",
    "desktop:dev": "electron .",
    "desktop:prepare-config": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/prepare-desktop-config.ps1",
    "desktop:backend:win": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build-backend-win.ps1",
    "desktop:backend:mac": "bash desktop/build-backend-macos.sh",
    "desktop:build:win": "npm run desktop:prepare-config && npm run desktop:backend:win && electron-builder --win nsis portable",
    "desktop:build:mac": "npm run desktop:prepare-config && npm run desktop:backend:mac && electron-builder --mac dmg zip",
    "desktop:pack": "npm run desktop:prepare-config && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.xingyunshe.marketdashboard",
    "productName": "星云社",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "web/assets/icon-512.png",
      "web/assets/icon-192.png",
      "web/assets/favicon.ico",
      "web/assets/xingyunshe-logo-transparent.png"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "dashboard",
        "filter": [
          "server.py",
          "service_guard.py",
          "requirements.txt",
          "web/**",
          "scripts/**",
          "src/**",
          "docs/**",
          "go/prior-high-monitor/**",
          "tools/dragon_wave_monitor_bridge.js",
          ".env.production.example",
          "!node_modules/**",
          "!release/**",
          "!dist-backend/**",
          "!__pycache__/**",
          "!.runtime-cache/**",
          "!.git/**",
          "!.env",
          "!.env.local",
          "!.env.production",
          "!dashboard-*.png",
          "!newsflash-preview.png"
        ]
      },
      {
        "from": "dist-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop-private/.env.desktop",
        "to": "dashboard/.env.desktop"
      },
      {
        "from": "desktop-private/runtime-seed",
        "to": "runtime-seed",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "web/assets/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "web/assets/icon-512.png",
      "category": "public.app-category.finance",
      "artifactName": "XingyunShe-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "XingyunShe-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星云社"
    },
    "portable": {
      "artifactName": "XingyunShe-Portable-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@relayprotocol/relay-sdk": "7.0.3",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "viem": "2.56.3"
  }
}
